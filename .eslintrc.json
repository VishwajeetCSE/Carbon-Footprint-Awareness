    "setupRangeSync": "readonly",
    "switchTab": "readonly",
    "renderChallenges": "readonly",
    "toggleChallenge": "readonly",
    "unlockBadge": "readonly",
    "closeBadgeAlert": "readonly",
    "showSystemNotification": "readonly",
    "startAutoplayDemo": "readonly"
