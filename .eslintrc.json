  },
  "extends": "eslint:recommended",
  "globals": {
    "lucide": "readonly",
    "appState": "writable",
    "EMISSION_FACTORS": "readonly",
    "BADGES": "readonly",
    "COACH_AI_RULES": "readonly",
    "WEEKS_PER_YEAR": "readonly",
    "MONTHS_PER_YEAR": "readonly",
    "DAYS_PER_YEAR": "readonly",
    "KG_TO_TON_FACTOR": "readonly",
