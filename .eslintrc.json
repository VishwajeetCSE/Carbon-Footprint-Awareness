    "POINTS_PER_LEVEL": "readonly",
    "lastActiveElement": "writable",
    "escapeHTML": "readonly",
    "getScoreCategoryName": "readonly",
    "getDiffExplanation": "readonly",
    "announceToScreenReader": "readonly",
    "sleep": "readonly",
    "safeQuerySelector": "readonly",
    "saveStateToLocalStorage": "readonly",
    "loadStateFromLocalStorage": "readonly",
    "validateStateSchema": "readonly",
